        // Re-enable after response paints (ajax replaces #form_engine_migrate_result)
        setTimeout(function() {
            var b = document.getElementById("form_engine_migrate_btn");
            if (b) {
                b.disabled = false;
                if (b.getAttribute("data-label")) b.innerHTML = b.getAttribute("data-label");
            }
        }, 8000);
    }

