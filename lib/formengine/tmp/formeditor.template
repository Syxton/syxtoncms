    function formEngineSaveHooks() {
        var byHook = {};
        function ensure(hid) {
            if (!byHook[hid]) byHook[hid] = {};
            return byHook[hid];
        }
        // Single-select slots
        document.querySelectorAll(".sfe-hook-field").forEach(function(sel) {
            var hid = sel.getAttribute("data-hook-id");
            if (!hid) return;
            var slot = sel.getAttribute("data-slot");
            if (!slot) slot = "";
            var v = sel.value ? sel.value : "";
            var bag = ensure(hid);
            if (slot) {
                bag[slot] = v ? [v] : [];
            } else if (v) {
                bag[v] = [v];
            }
        });
        // Multi-select slots (<select multiple>)
        document.querySelectorAll("select.sfe-hook-multi-select").forEach(function(sel) {
            var hid = sel.getAttribute("data-hook-id");
            if (!hid) return;
            var slot = sel.getAttribute("data-slot");
            if (!slot) slot = "value";
            var bag = ensure(hid);
            var keys = [];
            for (var i = 0; i < sel.options.length; i++) {
                if (sel.options[i].selected && sel.options[i].value) {
                    keys.push(sel.options[i].value);
                }
            }
            bag[slot] = keys;
        });
        // Legacy checkboxes if any remain
        document.querySelectorAll("input.sfe-hook-multi").forEach(function(cb) {
            var hid = cb.getAttribute("data-hook-id");
            if (!hid) return;
            var slot = cb.getAttribute("data-slot");
            if (!slot) slot = "value";
            var bag = ensure(hid);
            if (!bag[slot]) bag[slot] = [];
            if (cb.checked) bag[slot].push(cb.value);
        });
        var bindings = [];
        Object.keys(byHook).forEach(function(hid) {
            var bag = byHook[hid];
            var first = "";
            Object.keys(bag).forEach(function(s) {
                if (!first && bag[s] && bag[s].length) first = bag[s][0];
            });
            bindings.push({
                hook_id: hid,
                field_key: first,
                bindings: bag
            });
        });
        window.__sfeHooksJson = JSON.stringify(bindings);
        var out = document.getElementById("sfe-hooks-result");
        if (out) out.innerHTML = "<em>Saving…</em>";
        if (typeof form_engine_save_hooks === "function") {
            form_engine_save_hooks();
        }
    }

    function formEngineRunMigrate() {
